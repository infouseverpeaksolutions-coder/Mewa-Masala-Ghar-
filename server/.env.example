# ==============================================================================
# Mewa Masala Ghar - Backend Express API Environment Configuration Example
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database Connection (MySQL 8 with Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/mewa_masala_ghar"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Company & Compliance Defaults
COMPANY_NAME="Mewa Masala Ghar"
COMPANY_GSTIN="27AABCM1234F1Z5"
COMPANY_FSSAI="10021051000123"
COMPANY_STATE_CODE="27"
COMPANY_ADDRESS="Shop 14, APMC Grain Market, Sector 19, Vashi, Navi Mumbai, Maharashtra 400703"
COMPANY_EMAIL="care@mewamasalaghar.com"
COMPANY_PHONE="+91 98200 12345"

# Razorpay Payment Gateway (Optional in Dev - Simulated if credentials absent)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudinary CDN (Optional in Dev - Local disk upload fallback active if absent)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer SMTP (Optional in Dev - Console ethereal logger fallback if absent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Mewa Masala Ghar <care@mewamasalaghar.com>"
